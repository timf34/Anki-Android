<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/blocker_status_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/blocker_status_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_baseline_lock_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.ichi2.ui.FixedTextView
            android:id="@+id/blocker_status_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blocker_settings_title"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.ichi2.ui.FixedTextView
            android:id="@+id/blocker_status_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="3 apps, 1 website · 4 unlocks today" />

    </LinearLayout>

</LinearLayout>
